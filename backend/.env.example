# AINCURU × TAXLA — Backend environment template
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# NEVER commit `.env`.

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# Database — SQLite is the MVP default. To use Postgres, uncomment the
# POSTGRES_* block and replace DATABASE_URL/SYNC_DATABASE_URL below.
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./taxla.db
SYNC_DATABASE_URL=sqlite:///./taxla.db

# POSTGRES_USER=taxla_user
# POSTGRES_PASSWORD=change_me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=taxla_db
# DATABASE_URL=postgresql+asyncpg://taxla_user:change_me@localhost:5432/taxla_db
# SYNC_DATABASE_URL=postgresql+psycopg://taxla_user:change_me@localhost:5432/taxla_db

# ──────────────────────────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────────────────────
# Security — JWT_SECRET is REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app will refuse to start in non-dev environments if this is the
# placeholder `change_me`.
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_run_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ──────────────────────────────────────────────────────────────────────────────
# CORS — comma-separated allow-list. The frontend default is http://localhost:3000.
# Add your staging/prod frontend origins here as comma-separated values.
# ──────────────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Local AI / Ollama
# ──────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ──────────────────────────────────────────────────────────────────────────────
# File storage
# ──────────────────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
DOCUMENTS_DIR=./storage/documents
CERTIFICATES_DIR=./storage/certificates
UDYAM_PORTAL_URL=https://udyamregistration.gov.in/